<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Purple Gradient Background -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A1138" /> <!-- Dark Purple-Blue -->
                <item android:offset="0.5" android:color="#2A1B4B" /> <!-- Medium Purple -->
                <item android:offset="1.0" android:color="#3B2667" /> <!-- Deeper Purple Accent -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Center Flare (Purple-tinted) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="60"
                android:type="radial">
                <item android:offset="0.0" android:color="#20B89AFF" /> <!-- Faint Light Purple Flare -->
                <item android:offset="1.0" android:color="#00000000" /> <!-- Fade to Clear -->
            </gradient>
        </aapt:attr>
    </path>
</vector>