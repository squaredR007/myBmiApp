<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow Ring -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.99,28 Z"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#20B89AFF" />
                <item android:offset="1.0" android:color="#05FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 1. FULL TRACK (Dark Arc) - 180° Arc from Left (32,54) to Right (76,54) -->
    <path
        android:pathData="M 32,54 A 22,22 0 0,1 76,54"
        android:strokeColor="#35FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"/>

    <!-- 2. ACTIVE OVERLAY (Light Purple Arc) - 135° Arc terminating at (69.5, 38.5) -->
    <path
        android:pathData="M 32,54 A 22,22 0 0,1 69.5,38.5"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="54"
                android:endX="69.5"
                android:endY="38.5"
                android:type="linear">
                <item android:offset="0.0" android:color="#E3D0FF" />
                <item android:offset="1.0" android:color="#B89AFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Pivot Circle -->
    <path
        android:pathData="M54,54m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0"
        android:fillColor="#FFFFFF"/>

    <!-- 3. NEEDLE TRACKER - Extends directly from center (54,54) to the exact purple tip (69.5,38.5) -->
    <path
        android:pathData="M 54,54 L 69.5,38.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"/>

</vector>